# npm run dev at the repository root generates a private local .env automatically.
# These placeholders are for a separately managed PostgreSQL environment only.
PORT=5050
# Optional absolute path on a persistent disk; defaults to backend/.local/product-media
# MEDIA_DIRECTORY=/absolute/path/to/product-media
HOST=127.0.0.1
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/forme?schema=public"
JWT_SECRET=replace_with_a_random_secret
