# Copy to backend/.env and enter your own Neon connection string and secret.
# npm run dev starts only the API and frontend; it never creates a local database.
PORT=5050
# Optional absolute path on a persistent disk; defaults to backend/.local/product-media
# MEDIA_DIRECTORY=/absolute/path/to/product-media
HOST=127.0.0.1
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require"
JWT_SECRET=replace_with_a_random_secret
# Optional: an independent Neon test branch, never the application's branch.
# TEST_DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_TEST_ENDPOINT.neon.tech/neondb?sslmode=require"
